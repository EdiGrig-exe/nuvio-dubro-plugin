# DOAR pentru teste locale (`npm run dev-test`). Build-ul NU citește acest fișier și nimic de
# aici nu ajunge în bundle-ul publicat. În Nuvio, valorile se pun în
# Settings → Plugins → RoDub. Copiază în .env; .env nu se urcă pe GitHub.

# Cheia API TorBox: https://torbox.app/settings (secțiunea API)
TORBOX_API_KEY=

# Cheia TMDB v3 (API Key, nu Read Access Token): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# URL-ul unui addon Stremio configurat FĂRĂ debrid (returnează infoHash),
# fără "/manifest.json" la final. Gol = sursa e dezactivată.
SOURCE_URL=

# Worker-ul FileList, DOAR pentru `npm run worker:dev` local. În Cloudflare aceleași valori
# sunt secrete (`npx wrangler secret put ...`), iar în repo nu ajung niciodată.
FILELIST_USERNAME=
FILELIST_PASSKEY=
# Token aleator care protejează worker-ul; face parte din URL-ul sursei pus în Nuvio.
WORKER_TOKEN=
