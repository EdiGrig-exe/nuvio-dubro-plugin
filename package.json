{
  "name": "nuvio-rodub",
  "version": "1.0.0",
  "private": true,
  "description": "Provider Nuvio pentru stream-uri dublate în limba română, prin TorBox",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test": "node --test tests/filters.test.js tests/pipeline.test.js tests/scan.test.js tests/worker.test.js tests/worker-catalog.test.js",
    "dev-test": "node build.js && node test.js",
    "scan-secrets": "node tools/scan-secrets.js dist",
    "worker:dev": "node tools/worker-dev.js",
    "worker:deploy": "npx --yes wrangler@4.149.0 deploy --config worker/wrangler.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EdiGrig-exe/nuvio-dubro-plugin.git"
  }
}
